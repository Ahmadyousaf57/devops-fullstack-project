# ┌─────────────────────────────────────────────────────┐
# │  Root Environment Variables                         │
# │  Used by Docker Compose                             │
# │  Copy to .env: cp .env.example .env                 │
# └─────────────────────────────────────────────────────┘

# Docker Hub username (for pushing images)
DOCKER_HUB_USERNAME=your_dockerhub_username

# MongoDB
MONGO_INITDB_DATABASE=todoapp

# Backend
BACKEND_PORT=4000
NODE_ENV=production

# Frontend
FRONTEND_PORT=3000
